# ──────────────────────────────────────────────
# Monitor Monotributo — Variables de entorno
# Copiar a .env y completar con valores reales
# ──────────────────────────────────────────────

# ── Base de datos ──
MONITOR_DB_USER=monitor
MONITOR_DB_PASSWORD=change-me-in-prod
MONITOR_DB_NAME=monitor

# ── App Flask ──
MONITOR_SECRET_KEY=change-me-in-prod

# ── RPA / Playwright ──
ARCA_WEB=https://www.afip.gob.ar/landing/default.asp
PLAYWRIGHT_HEADLESS=1
RECORDING=FALSE

# ── Puertos DEV (solo aplica con docker-compose.dev.yml) ──
MONITOR_WEB_PORT=5000
MONITOR_PG_PORT=5432
MONITOR_REDIS_PORT=6379
